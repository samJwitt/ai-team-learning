@page "/apps/new"
@rendermode InteractiveServer
@using HomelabInventory.Web.Models
@using HomelabInventory.Web.Services.Apps
@inject TrackedAppService AppService
@inject NavigationManager Navigation

<PageTitle>Add app</PageTitle>

<h1>Add app</h1>

@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <ul>
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<EditForm Model="draft" OnValidSubmit="HandleSubmitAsync">
    <div class="mb-3">
        <label class="form-label">Name *</label>
        <InputText class="form-control" @bind-Value="draft.Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea class="form-control" @bind-Value="draft.Description" />
    </div>
    <div class="mb-3">
        <label class="form-label">Host or IP *</label>
        <InputText class="form-control" @bind-Value="draft.HostnameOrIp" />
    </div>
    <div class="mb-3">
        <label class="form-label">Port</label>
        <InputNumber class="form-control" @bind-Value="draft.Port" />
    </div>
    <div class="mb-3">
        <label class="form-label">URL</label>
        <InputText class="form-control" @bind-Value="draft.Url" />
    </div>
    <div class="mb-3">
        <label class="form-label">Deployed on</label>
        <InputText class="form-control" @bind-Value="draft.DeployedOn" />
    </div>
    <div class="mb-3">
        <label class="form-label">Served via</label>
        <InputSelect class="form-control" @bind-Value="draft.ServedVia">
            <option value="@ServedVia.Container">Container</option>
            <option value="@ServedVia.Systemd">Systemd</option>
            <option value="@ServedVia.Static">Static</option>
            <option value="@ServedVia.Other">Other</option>
        </InputSelect>
    </div>
    <div class="mb-3">
        <label class="form-label">Proxy path</label>
        <InputText class="form-control" @bind-Value="draft.ProxyPath" />
    </div>
    <div class="mb-3">
        <label class="form-label">Repository URL</label>
        <InputText class="form-control" @bind-Value="draft.RepoUrl" />
    </div>
    <div class="mb-3">
        <label class="form-label">Branch</label>
        <InputText class="form-control" @bind-Value="draft.Branch" />
    </div>
    <div class="mb-3">
        <label class="form-label">Container image</label>
        <InputText class="form-control" @bind-Value="draft.ContainerImage" />
    </div>
    <button type="submit" class="btn btn-primary">Create app</button>
    <a class="btn btn-secondary" href="/apps">Cancel</a>
</EditForm>

@code {
    private TrackedApp draft = new();
    private IReadOnlyList<string> errors = [];

    private async Task HandleSubmitAsync()
    {
        var result = await AppService.CreateAsync(draft);
        if (result.Success && result.App is not null)
        {
            Navigation.NavigateTo($"/apps/{result.App.Id}");
        }
        else
        {
            errors = result.Errors;
        }
    }
}
